# Local dev default matches docker-compose.yml's postgres service.
DATABASE_URL=postgres://webhooks:webhooks@localhost:5532/webhooks_node
PORT=3000

# ADR-008: the shared frontend/ SPA calls this API cross-origin. "*" is
# fine for local dev/demo (Bearer-token auth, no cookies to leak); pin to
# the real frontend origin for anything beyond that.
CORS_ORIGIN=*

# Retry backoff (full jitter): delay = random(0, min(base * multiplier^attempt, max))
BACKOFF_BASE_DELAY_MS=1000
BACKOFF_MULTIPLIER=2
BACKOFF_MAX_DELAY_MS=30000
BACKOFF_MAX_ATTEMPTS=6

# Outbound webhook delivery bounds (R-16). No redirect-count setting —
# docs/adr/0006 decided delivery never follows redirects at all.
OUTBOUND_CONNECT_TIMEOUT_MS=5000
OUTBOUND_TOTAL_TIMEOUT_MS=10000
OUTBOUND_MAX_RESPONSE_BODY_BYTES=65536
OUTBOUND_MAX_CONNECTIONS_PER_HOST=10

# Lease duration (crash recovery, ADR-003) = OUTBOUND_TOTAL_TIMEOUT_MS +
# max(OUTBOUND_TOTAL_TIMEOUT_MS, this floor). Production keeps a 30s floor
# even if the outbound timeout is tiny; make chaos lowers this via env to
# make lease expiry fast instead of always waiting 30s+.
LEASE_MIN_DURATION_MS=30000

# Receiver signature verification tolerance, seconds
SIGNATURE_TIMESTAMP_TOLERANCE_SEC=300

# Secret rotation overlap window, hours — the sender signs with both the
# current and secondary secret until this elapses (ADR-0003).
SECRET_ROTATION_OVERLAP_HOURS=24

# Signing secrets are encrypted at rest with this key (AES-256-GCM, 32 bytes,
# base64). This example key is for local dev ONLY — generate your own with:
#   openssl rand -base64 32
SECRET_ENCRYPTION_KEY=uVnfLJGuLvn8ZwxpLXFXIw8irrEhzVUIqM6SneLB6Sc=

# Worker poll loop: how long to wait after a cycle finds nothing to do before
# polling again. 0 whenever work was found, so a backlog drains immediately.
WORKER_IDLE_POLL_INTERVAL_MS=200
